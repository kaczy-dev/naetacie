{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./lib",
    "rootDir": "..",
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@lib/*": ["../lib/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "../lib/types/**/*.ts"],
  "exclude": ["node_modules", "lib"]
}
